# Secrets — never commit
.env
.env.*
.env*
*.key
credentials.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/

# Lab run artifacts
lab/**/traces/*.jsonl
lab/**/.cache/
drills/mocks/attempts/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Generated mocks are reproducible from their seed
drills/mocks/*.yaml

# Site toolchain
node_modules/
dist/
coverage/
*.log
site/playwright-report/
site/test-results/
site/.astro/

# Isolated fixture builds from the domain-content e2e test
site/.us2-*

# Generated site data and the runtime bundle — derived from BLUEPRINT.md, drills/bank/,
# lab/, and drills/ at build time. A committed copy would be the duplication FR-001 forbids.
site/src/data/mock.json
site/src/data/items.json
site/public/runtime/
