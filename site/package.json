{
  "name": "ccdv-f-study-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "export:data": "python ../tools/export_site_data.py && python ../tools/export_mock_data.py && python ../tools/export_item_bank.py && python ../tools/export_runtime_bundle.py && node scripts/vendor-runtime.mjs",
    "predev": "npm run export:data",
    "prebuild": "npm run export:data",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit --project tsconfig.worker.json",
    "lint": "eslint .",
    "build": "astro build && pagefind --site dist",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "check:payload": "node scripts/check-payload.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.3.0",
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "9.35.0",
    "@playwright/test": "1.59.1",
    "@tailwindcss/vite": "4.1.13",
    "@types/node": "22.20.1",
    "astro": "7.3.1",
    "eslint": "9.35.0",
    "eslint-plugin-astro": "1.7.0",
    "pagefind": "1.4.0",
    "playwright": "1.59.1",
    "pyodide": "314.0.6",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vitest": "3.2.7"
  }
}
