---
import ThemeToggle from "../components/ThemeToggle.astro";
import "../styles/global.css";
import { themeBootstrapScript } from "../lib/storage";

interface Props {
  description?: string;
  showThemeToggle?: boolean;
  title?: string;
}

const {
  description = "A community study kit for CCDV-F certification.",
  showThemeToggle = true,
  title = "CCDV-F community study kit"
} = Astro.props;

const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline set:html={themeBootstrapScript}></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-name" href={href("")}>CCDV-F community study kit</a>
        <nav class="site-nav" aria-label="Site navigation">
          <a href={href("blueprint/")}>Blueprint</a>
          <a href={href("domains/")}>Domains</a>
          <a href={href("plans/")}>Plans</a>
          <a href={href("diagnostic/")}>Diagnostic</a>
          <a href={href("labs/")}>Labs</a>
          <a href={href("mock/")}>Mock exam</a>
          <a href={href("flashcards/")}>Flashcards</a>
          <a href={href("playground/")}>Playground</a>
          {showThemeToggle && <ThemeToggle />}
        </nav>
      </div>
    </header>
    <main id="main-content" class="page-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <p>
          CCDV-F community study kit is unofficial and not affiliated with, endorsed by, or produced
          by Anthropic. Code is MIT; written study content is CC BY 4.0.
        </p>
      </div>
    </footer>
  </body>
</html>
