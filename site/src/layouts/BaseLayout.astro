---
import SearchDialog from "../components/SearchDialog.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import "../styles/global.css";
import "../styles/print.css";
import { themeBootstrapScript } from "../lib/storage";
import { buildSearchAttributes, type SearchRecordOptions } from "../lib/search";

interface Props {
  description?: string;
  searchRecord?: SearchRecordOptions;
  showSearch?: boolean;
  showThemeToggle?: boolean;
  title?: string;
}

const {
  description = "A community study kit for CCDV-F certification.",
  searchRecord,
  showThemeToggle = true,
  showSearch = showThemeToggle,
  title = "CCDV-F community study kit"
} = Astro.props;

const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path}`;
const searchAttrs = buildSearchAttributes(searchRecord ?? {});
---

<!doctype html>
<html lang="en" data-base={base}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline set:html={themeBootstrapScript}></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-name" href={href("")}>CCDV-F community study kit</a>
        <nav class="site-nav" aria-label="Site navigation">
          <a href={href("blueprint/")}>Blueprint</a>
          <a href={href("domains/")}>Domains</a>
          <a href={href("plans/")}>Plans</a>
          <a href={href("diagnostic/")}>Diagnostic</a>
          <a href={href("labs/")}>Labs</a>
          <a href={href("mock/")}>Mock exam</a>
          <a href={href("flashcards/")}>Flashcards</a>
          <a href={href("playground/")}>Playground</a>
          {showThemeToggle && <ThemeToggle />}
          {
            showSearch && (
              <a
                role="button"
                href="#search-dialog"
                class="search-trigger search-trigger--header"
                tabindex="-1"
                aria-hidden="true"
              >
                <svg
                  class="search-trigger__icon"
                  aria-hidden="true"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="11" cy="11" r="8" />
                  <line x1="21" y1="21" x2="16.65" y2="16.65" />
                </svg>
                <span>Search</span>
                <kbd class="search-trigger__shortcut" aria-hidden="true">Ctrl K</kbd>
              </a>
            )
          }
        </nav>
      </div>
    </header>
    <main id="main-content" class="page-content" {...searchAttrs}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <p>
          CCDV-F community study kit is unofficial and not affiliated with, endorsed by, or produced
          by Anthropic. Code is MIT; written study content is CC BY 4.0.
        </p>
        {
          showSearch && (
            <div class="site-footer__search">
              <a
                role="button"
                href="#search-dialog"
                class="search-trigger"
                id="search-trigger"
                data-testid="search-trigger"
                aria-label="Search study kit (Ctrl+K or Cmd+K)"
                aria-keyshortcuts="Control+K Meta+K"
              >
                <svg
                  class="search-trigger__icon"
                  aria-hidden="true"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="11" cy="11" r="8" />
                  <line x1="21" y1="21" x2="16.65" y2="16.65" />
                </svg>
                <span>Search</span>
                <kbd class="search-trigger__shortcut" aria-hidden="true">Ctrl K</kbd>
              </a>
            </div>
          )
        }
      </div>
    </footer>
    {showSearch && <SearchDialog />}
  </body>
</html>
