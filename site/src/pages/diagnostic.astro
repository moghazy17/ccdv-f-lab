---
import Diagnostic from "../components/Diagnostic.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path}`;
---

<BaseLayout
  title="Study plan recommender | CCDV-F community study kit"
  description="Self-report diagnostic to recommend an exam preparation schedule tailored to your time budget."
>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={href("plans/")}>&larr; Study plans</a>
  </nav>

  <h1>Study plan recommender</h1>
  <p class="page-introduction">
    Find the study plan that best fits your target exam date, weekly availability, and prior experience.
  </p>

  <Diagnostic />
</BaseLayout>

<style>
  .breadcrumb {
    margin-bottom: 1.5rem;
    font-size: 0.925rem;
  }
</style>
